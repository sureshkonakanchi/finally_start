# Copy to .env (gitignored) and fill in. Never commit real keys.

# Required for AI chat: OpenRouter API key
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: Massive (Polygon.io) API key for real market data.
# Leave empty to use the built-in market simulator (recommended).
MASSIVE_API_KEY=

# Optional: "true" for deterministic mock LLM responses (used by E2E tests)
LLM_MOCK=false
